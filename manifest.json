{
  "manifest_version": 3,
  "name": "ChatGPT Version Arrows",
  "version": "0.6.4",
  "version_name": "0.6.4",
  "description": "Restores previous/next version arrows for edited messages and regenerated responses.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["patch.js", "app-shell-pagination.js"],
      "css": ["app-shell-pagination.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
