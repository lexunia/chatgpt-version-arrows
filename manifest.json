{
  "manifest_version": 3,
  "name": "ChatGPT Version Arrows",
  "version": "0.7.0",
  "version_name": "0.7.0 Beta 12",
  "description": "Restores previous/next version arrows for edited messages and regenerated responses.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["patch.js", "conversation-text.js", "conversation-branch.js", "conversation-export.js", "conversation-graph.js", "app-shell-pagination.js"],
      "css": ["app-shell-pagination.css", "conversation-graph.css", "conversation-export.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
